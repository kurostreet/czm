 // Build credentials only into the packet for its actual destination. Never mutate
 // cls.userinfo: config writes, local player info and later connections stay clean.
+// Android owns HTTPS. No game-thread HTTP, credentials, cvar overrides or config-based bans.
+static int CZM_ServerPolicyCall( const char *address )
+{
+#ifdef __ANDROID__
+ JNIEnv *env = Android_GetNativeObject( "JNIEnv" );
+ int state = -1;
+ if( !env ) return state;
+ if( (*env)->PushLocalFrame( env, 8 ) < 0 )
+ {
+  if( (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+  return state;
+ }
+ jclass netclass = (*env)->FindClass( env, "ru/kurostreet/counterzombiemobile/CzmNet" );
+ if( netclass && !(*env)->ExceptionCheck( env ))
+ {
+  jmethodID method = (*env)->GetStaticMethodID( env, netclass,
+   address ? "serverPolicyState" : "serverPolicyBegin", address ? "(Ljava/lang/String;)I" : "()V" );
+  if( method && !(*env)->ExceptionCheck( env ))
+  {
+   if( address ) state = (*env)->CallStaticIntMethod( env, netclass, method, (*env)->NewStringUTF( env, address ));
+   else { (*env)->CallStaticVoidMethod( env, netclass, method ); state = 0; }
+  }
+ }
+ if( (*env)->ExceptionCheck( env )) { (*env)->ExceptionClear( env ); state = -1; }
+ (*env)->PopLocalFrame( env, NULL );
+ return state;
+#else
+ return 1;
+#endif
+}
+
+static qboolean CZM_ServerPolicyAllowed( netadr_t adr )
+{
+ if( NET_IsLocalAddress( adr )) return true;
+ int state = CZM_ServerPolicyCall( NET_AdrToString( adr ));
+ if( state == 1 ) return true;
+ if( state == 0 ) return false; // keep retry counters unchanged while HTTPS runs
+ const char *reason = state == 2 ? "#czm_server_blocked" : state == 3 ? "#czm_server_hidden" : "#czm_server_policy";
+ CZM_Loading_SetError( reason );
+ CL_Disconnect();
+ Cvar_Set( "czm_loading_error", reason );
+ UI_SetActiveMenu( true );
+ return false;
+}
+
+// A confirmed restriction also closes an existing remote session. A failed
+// background refresh never interrupts a match merely because HTTPS is down.
+static void CZM_ServerPolicyFrame( void )
+{
+ static double next;
+ if( cls.state < ca_connected || cls.demoplayback || NET_IsLocalAddress( cls.netchan.remote_address )) return;
+ if( host.realtime < next && host.realtime >= next - 1.0 ) return;
+ next = host.realtime + 1.0;
+ if( CZM_ServerPolicyCall( NET_AdrToString( cls.netchan.remote_address )) == 2 )
+  CZM_ServerPolicyAllowed( cls.netchan.remote_address );
+}
