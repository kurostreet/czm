+static void HTTP_CloseIPv4Probe( httpfile_t *file )
+{
+	if( file->ipv4_socket != -1 )
+		closesocket( file->ipv4_socket );
+	file->ipv4_socket = -1;
+}
+
+static void HTTP_CloseTransfer( httpfile_t *file )
+{
+	HTTP_CloseIPv4Probe( file );
+	if( file->file )
+		FS_Close( file->file );
+	file->file = NULL;
+	if( file->tls )
+		HTTP_TlsFree( file->tls );
+	file->tls = NULL;
+	if( file->socket != -1 )
+	{
+		closesocket( file->socket );
+		http.active_count--;
+	}
+	file->socket = -1;
+	if( file->buf )
+		Mem_Free( file->buf );
+	file->buf = NULL;
+}
+
+// A DNS answer can put an unusable IPv6 route first. Probe IPv4 without
+// discarding the original connection: IPv6-only networks must still work.
+// Each transfer gets at most one probe, with a bounded DNS/connect wait.
+static qboolean HTTP_RetryIPv4( httpfile_t *file )
+{
+	if( !file->server || file->ipv4_done || file->addr.ss_family != AF_INET6
+		|| file->got_response || file->downloaded > 0 || Q_strchr( file->server->host, ':' ))
+		return false;
+
+	double now = Platform_DoubleTime();
+	if( !file->ipv4_started )
+		file->ipv4_started = now;
+	if( now - file->ipv4_started >= 5.0 )
+	{
+		HTTP_CloseIPv4Probe( file );
+		file->ipv4_done = true;
+		return false;
+	}
+
+	if( file->ipv4_socket == -1 )
+	{
+		if( file->server->resolved && file->server->addr.ss_family == AF_INET )
+			file->ipv4_addr = file->server->addr;
+		else
+		{
+			if( http.resolving ) return true;
+			net_gai_state_t res = NET_StringToSockaddr( file->server->host, &file->ipv4_addr, true, AF_INET );
+			if( res == NET_EAI_AGAIN )
+			{
+				http.resolving = true;
+				return true;
+			}
+			if( res != NET_EAI_OK )
+			{
+				file->ipv4_done = true;
+				return false;
+			}
+			// The shared async resolver may return an older request for this
+			// hostname. Consume it, then request the required address family.
+			if( file->ipv4_addr.ss_family != AF_INET )
+			{
+				http.resolving = true;
+				return true;
+			}
+		}
+		((struct sockaddr_in *)&file->ipv4_addr)->sin_port = MSG_BigShort( file->server->port );
+		file->ipv4_socket = socket( AF_INET, SOCK_STREAM, IPPROTO_TCP );
+		if( file->ipv4_socket < 0 || !NET_MakeSocketNonBlocking( file->ipv4_socket ))
+		{
+			HTTP_CloseIPv4Probe( file );
+			file->ipv4_done = true;
+			return false;
+		}
+		int ret = connect( file->ipv4_socket, (struct sockaddr *)&file->ipv4_addr, sizeof( struct sockaddr_in ));
+		int err = ret < 0 ? WSAGetLastError() : 0;
+		if( ret < 0 && err != WSAEWOULDBLOCK && err != WSAEINPROGRESS )
+		{
+			HTTP_CloseIPv4Probe( file );
+			file->ipv4_done = true;
+			return false;
+		}
+	}
+
+	fd_set writefds, exceptfds;
+	struct timeval tv = { 0 };
+	FD_ZERO( &writefds ); FD_ZERO( &exceptfds );
+	FD_SET( file->ipv4_socket, &writefds ); FD_SET( file->ipv4_socket, &exceptfds );
+	int ready = select( file->ipv4_socket + 1, NULL, &writefds, &exceptfds, &tv );
+	if( ready == 0 ) return true;
+	int err = 0;
+	socklen_t len = sizeof( err );
+	if( ready < 0 || getsockopt( file->ipv4_socket, SOL_SOCKET, SO_ERROR, (char *)&err, &len ) < 0 || err )
+	{
+		HTTP_CloseIPv4Probe( file );
+		file->ipv4_done = true;
+		return false;
+	}
+
+	int connected = file->ipv4_socket;
+	file->ipv4_socket = -1;
+	HTTP_CloseTransfer( file );
+	file->socket = connected;
+	http.active_count++;
+	file->buf = Mem_Calloc( http_mempool, MAX_HTTP_BUFFER_SIZE + 1 );
+	file->addr = file->ipv4_addr;
+	file->server->addr = file->addr;
+	file->server->resolved = true;
+	file->ipv4_done = true;
+	file->blocktime = 0;
+	file->header_size = file->bytes_sent = file->query_length = 0;
+	file->pfn_process = HTTP_FilePrepareRequest;
+	Con_Reportf( "HTTP: using IPv4 for %s after unavailable IPv6\n", file->server->host );
+	return true;
+}
