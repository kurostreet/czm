 void CZM_Loading_SetError( const char *reason )
 {
+	if( COM_StringEmpty( reason ))
+		return;
+
+	// thrown out of a running game: kept until the disconnect, the first reason wins
+	if( !czm.active )
+	{
+		if( cls.state == ca_active && ( COM_StringEmpty( czm.game_error ) || host.realtime - czm.game_error_time > 5.0 ))
+		{
+			Q_strncpy( czm.game_error, reason, sizeof( czm.game_error ));
+			czm.game_error_time = host.realtime;
+		}
+		return;
+	}
+
 	// A later generic disconnect must not replace the server's original reason.
-	if( !czm.active || czm.cancelled || !COM_StringEmpty( czm.error ) || COM_StringEmpty( reason ))
+	if( czm.cancelled || !COM_StringEmpty( czm.error ))
 		return;
 
 	Q_strncpy( czm.error, reason, sizeof( czm.error ));
 }
 
+void CZM_Loading_Dropped( void )
+{
+	// the server or an error ended the game, not the player: the menu says so even without a reason
+	if( !czm.active )
+		CZM_Loading_SetError( "#connection_lost" );
+}
