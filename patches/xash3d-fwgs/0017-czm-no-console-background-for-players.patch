 /*
 ================
+Con_DrawCzmBackground
+
+Counter Zombie Mobile: our wide picture fills the screen without stretching
+(cropped to the screen's shape) and is dimmed, so the text and the menu stay readable
+================
+*/
+static void Con_DrawCzmBackground( int lines )
+{
+	int w = REF_GET_PARM( PARM_TEX_SRC_WIDTH, con.background );
+	int h = REF_GET_PARM( PARM_TEX_SRC_HEIGHT, con.background );
+	float s1 = 0.0f, t1 = 0.0f, s2 = 1.0f, t2 = 1.0f;
+
+	if( w > 0 && h > 0 && refState.width > 0 && refState.height > 0 )
+	{
+		float screen = (float)refState.width / refState.height;
+		float image = (float)w / h;
+
+		if( screen > image )
+		{
+			t1 = ( 1.0f - image / screen ) * 0.5f;
+			t2 = 1.0f - t1;
+		}
+		else
+		{
+			s1 = ( 1.0f - screen / image ) * 0.5f;
+			s2 = 1.0f - s1;
+		}
+	}
+
+	ref.dllFuncs.Color4ub( 120, 120, 120, 255 );
+	ref.dllFuncs.R_DrawStretchPic( 0, lines - refState.height, refState.width, refState.height, s1, t1, s2, t2, con.background );
+	ref.dllFuncs.Color4ub( 255, 255, 255, 255 );
+}
+
