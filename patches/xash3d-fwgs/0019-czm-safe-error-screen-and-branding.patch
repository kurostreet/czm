+// Never fall back to artwork supplied by the legacy game data, even when
+// a texture is missing or its upload fails on a particular renderer.
+static int Con_LoadCzmBackground( int flags )
+{
+	const char *pictures[] = { CZM_CONBACK, "gfx/czm/menu_bg.png" };
+	con_czm_background = false;
+	for( int i = 0; i < ARRAYSIZE( pictures ); i++ )
+	{
+		if( !g_fsapi.FileExists( pictures[i], false ))
+			continue;
+		int texture = ref.dllFuncs.GL_LoadTexture( pictures[i], NULL, 0, flags );
+		if( texture && texture != R_GetBuiltinTexture( REF_DEFAULT_TEXTURE ))
+		{
+			con_czm_background = true;
+			return texture;
+		}
+	}
+	return R_GetBuiltinTexture( REF_GRAY_TEXTURE );
+}
