diff --git a/engine/common/czm_resource_mount.h b/engine/common/czm_resource_mount.h
new file mode 100644
--- /dev/null
+++ b/engine/common/czm_resource_mount.h
@@ -0,0 +1,59 @@
+/* Managed resource mount boundary. No command/cvar can supply a mount path. */
+#ifndef CZM_RESOURCE_MOUNT_H
+#define CZM_RESOURCE_MOUNT_H
+#include <string.h>
+
+#define CZM_RESOURCE_PATH_MAX 1024
+
+typedef struct czm_resource_mount_s
+{
+ char root[CZM_RESOURCE_PATH_MAX];
+ char path[CZM_RESOURCE_PATH_MAX];
+} czm_resource_mount_t;
+
+/* The installer owns files/game; resource packs live in its sibling directory. */
+static inline void CZM_ResourceRoot( czm_resource_mount_t *state, const char *game_root )
+{
+ const char *slash;
+ size_t length;
+ state->root[0] = state->path[0] = 0;
+ if( !game_root || game_root[0] != '/' || !( slash = strrchr( game_root, '/' ))) return;
+ if( strcmp( slash + 1, "game" )) return;
+ length = (size_t)( slash - game_root ) + 1;
+ if( length + sizeof( "server-resources/" ) > sizeof( state->root )) return;
+ memcpy( state->root, game_root, length );
+ memcpy( state->root + length, "server-resources/", sizeof( "server-resources/" ));
+}
+
+static inline int CZM_ResourceToken( const char **cursor )
+{
+ const char *start = *cursor;
+ while( **cursor && **cursor != '/' )
+ {
+  const unsigned char c = (unsigned char)**cursor;
+  if( !(( c >= 'a' && c <= 'z' ) || ( c >= 'A' && c <= 'Z' )
+   || ( c >= '0' && c <= '9' ) || c == '_' || c == '-' )) return 0;
+  if( ++*cursor - start > 64 ) return 0;
+ }
+ return *cursor != start && *(*cursor)++ == '/';
+}
+
+static inline int CZM_ResourcePathValid( const czm_resource_mount_t *state, const char *path )
+{
+ size_t root_length = strlen( state->root );
+ const char *suffix;
+ if( !root_length || !path || strlen( path ) >= sizeof( state->path )
+  || strncmp( path, state->root, root_length )) return 0;
+ suffix = path + root_length;
+ return CZM_ResourceToken( &suffix ) && CZM_ResourceToken( &suffix ) && !strcmp( suffix, "files" );
+}
+
+/* An invalid path revokes the old mount rather than retaining another server's data. */
+static inline int CZM_ResourceSelect( czm_resource_mount_t *state, const char *path )
+{
+ if( !CZM_ResourcePathValid( state, path )) path = "";
+ if( !strcmp( state->path, path )) return 0;
+ memcpy( state->path, path, strlen( path ) + 1 );
+ return 1;
+}
+#endif
