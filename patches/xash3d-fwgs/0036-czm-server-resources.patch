diff --git a/engine/client/cl_main.c b/engine/client/cl_main.c
--- a/engine/client/cl_main.c
+++ b/engine/client/cl_main.c
@@ -1259,6 +1259,99 @@
 	convar_t *choice = Cvar_FindVar( "czm_diagnostics" );
 	if( choice && CZM_Loading_Enabled() )
 		Cvar_DirectSetValue( &host_developer, bound( 0, (int)choice->value, 2 ));
+}
+
+// A one-use Java grant comes from the trusted catalog/verified loader, not a
+// server, cvar or console command. Pin it to the actual resolved endpoint for
+// this connection. Filesystem rescans reuse the pinned mount without JNI/network.
+static string czm_resources_address;
+static qboolean czm_resources_mounted;
+static void CZM_ServerResourcesClear( void );
+
+static qboolean CZM_ServerResourcesReject( void )
+{
+	const char *reason = "#czm_server_resources";
+	CZM_ServerResourcesClear();
+	CZM_Loading_SetError( reason );
+	CL_Disconnect();
+	Cvar_Set( "czm_loading_error", reason );
+	UI_SetActiveMenu( true );
+	return false;
+}
+
+static qboolean CZM_ServerResourcesBind( netadr_t adr )
+{
+	const char *address = NET_AdrToString( adr );
+	if( !Q_strcmp( czm_resources_address, address )) return true;
+	CZM_ServerResourcesClear();
+	Q_strncpy( czm_resources_address, address, sizeof( czm_resources_address ));
+#ifdef __ANDROID__
+	qboolean rejected = true;
+	JNIEnv *env = Android_GetNativeObject( "JNIEnv" );
+	if( !env ) return CZM_ServerResourcesReject();
+	if( (*env)->PushLocalFrame( env, 8 ) < 0 )
+	{
+		if( (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+		return CZM_ServerResourcesReject();
+	}
+	jclass netclass = (*env)->FindClass( env, "ru/kurostreet/counterzombiemobile/CzmNet" );
+	if( netclass && !(*env)->ExceptionCheck( env ))
+	{
+		jmethodID method = (*env)->GetStaticMethodID( env, netclass, "serverResourcesMountPath", "(Ljava/lang/String;)Ljava/lang/String;" );
+		if( method && !(*env)->ExceptionCheck( env ))
+		{
+			jstring endpoint = (*env)->NewStringUTF( env, address );
+			if( endpoint && !(*env)->ExceptionCheck( env ))
+			{
+				czm_resources_mounted = true; // method may acquire the Java in-use lease
+				jstring path = (*env)->CallStaticObjectMethod( env, netclass, method, endpoint );
+				if( path && !(*env)->ExceptionCheck( env ))
+				{
+					const char *chars = (*env)->GetStringUTFChars( env, path, NULL );
+					if( chars )
+					{
+						czm_resources_mounted = chars[0] != 0;
+						rejected = czm_resources_mounted && !FS_CzmSetServerResources( chars );
+						(*env)->ReleaseStringUTFChars( env, path, chars );
+					}
+				}
+			}
+		}
+	}
+	if( (*env)->ExceptionCheck( env ))
+	{
+		rejected = true;
+		(*env)->ExceptionClear( env );
+	}
+	(*env)->PopLocalFrame( env, NULL );
+	if( rejected ) return CZM_ServerResourcesReject();
+#endif
+	return true;
+}
+
+static void CZM_ServerResourcesClear( void )
+{
+	FS_CzmSetServerResources( "" );
+	czm_resources_address[0] = 0;
+#ifdef __ANDROID__
+	if( czm_resources_mounted )
+	{
+		JNIEnv *env = Android_GetNativeObject( "JNIEnv" );
+		if( env && (*env)->PushLocalFrame( env, 4 ) >= 0 )
+		{
+			jclass netclass = (*env)->FindClass( env, "ru/kurostreet/counterzombiemobile/CzmNet" );
+			if( netclass && !(*env)->ExceptionCheck( env ))
+			{
+				jmethodID method = (*env)->GetStaticMethodID( env, netclass, "serverResourcesUnmounted", "()V" );
+				if( method && !(*env)->ExceptionCheck( env )) (*env)->CallStaticVoidMethod( env, netclass, method );
+			}
+			if( (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+			(*env)->PopLocalFrame( env, NULL );
+		}
+		else if( env && (*env)->ExceptionCheck( env )) (*env)->ExceptionClear( env );
+	}
+#endif
+	czm_resources_mounted = false;
 }
 
