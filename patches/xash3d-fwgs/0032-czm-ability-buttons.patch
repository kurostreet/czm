+// A held ability must be released before a menu takes its finger or a layout is replaced.
+static void Touch_CzmCancelSkillHolds( void )
+{
+    for( touch_button_t *b = touch.list_user.first; b; b = b->next )
+    {
+        if( Q_strcmp( b->command, "+czm_skill_e" ) || (b->finger == -1 && !b->latched)) continue;
