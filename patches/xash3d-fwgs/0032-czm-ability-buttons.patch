+static int Touch_CzmSkillSlot( const char *command )
+{
+    if( !Q_strcmp( command, "czm_skill_g" )) return 0;
+    if( !Q_strcmp( command, "czm_skill_r" )) return 1;
+    if( !Q_strcmp( command, "+czm_skill_e" )) return 2;
+    return -1;
+}
