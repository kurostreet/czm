+// Called after the selected profile has loaded. Existing commands retain every saved field.
+static void Touch_CzmEnsureSkills( qboolean force )
+{
+    if( !force && ( !touch.config_loaded || cls.state != ca_active || !(int)czm_skill_mask.value )) return;
+    static const char *commands[] = { "czm_skill_g", "czm_skill_r", "+czm_skill_e" };
+    static const char *names[] = { "czm_skill_g", "czm_skill_r", "czm_skill_e" };
+    static const float positions[] = { 0.70f, 0.775f, 0.625f };
+    byte color[4] = { 255, 255, 255, 235 };
+    for( int i = 0; i < 3; i++ )
+    {
+        qboolean exists = false;
+        for( touch_button_t *b = touch.list_user.first; b; b = b->next )
+            if( !Q_strcmp( b->command, commands[i] )) { exists = true; break; }
+        if( exists ) continue;
+        char texture[80];
+        Q_snprintf( texture, sizeof( texture ), "gfx/czm/touch/skill_%c.png", "gre"[i] );
+        touch_button_t *b = Touch_AddButton( &touch.list_user, names[i], texture, commands[i],
+            positions[i], 0.61f, positions[i] + 0.055f, 0.61f + 0.055f / Touch_AspectRatio(), color, true );
+        b->aspect = 1.0f;
+        touch.configchanged = true;
+    }
+}
+
+static void Touch_CzmEnsureSkills_f( void ) { Touch_CzmEnsureSkills( true ); }
+
+static void Touch_CzmPublishAnchors( void )
+{
+    int bounds[12] = {0};
+    for( touch_button_t *b = touch.list_user.first; b; b = b->next )
+    {
+        int slot = Touch_CzmSkillSlot( b->command );
+        if( slot >= 0 && slot < 3 && !Touch_IsVisible( b ) && b->finger != -1 )
+        {
+            if( b->command[0] == '+' )
+            {
+                char release[260]; Q_snprintf( release, sizeof( release ), "-%s\n", b->command + 1 );
+                Touch_AddButtonCommand( b, release );
+            }
+            b->finger = -1;
+        }
+        if( slot < 0 || !Touch_IsVisible( b )) continue;
+        if( bounds[slot * 4 + 2] && b->finger == -1 ) continue;
+        bounds[slot * 4] = TO_SCRN_X( b->x1 ); bounds[slot * 4 + 1] = TO_SCRN_Y( b->y1 );
+        bounds[slot * 4 + 2] = TO_SCRN_X( b->x2 ); bounds[slot * 4 + 3] = TO_SCRN_Y( b->y2 );
+    }
+    char value[256];
+    Q_snprintf( value, sizeof( value ), "%d %d %d %d %d %d %d %d %d %d %d %d",
+        bounds[0],bounds[1],bounds[2],bounds[3],bounds[4],bounds[5],bounds[6],bounds[7],
+        bounds[8],bounds[9],bounds[10],bounds[11] );
+    if( Q_strcmp( value, czm_touch_anchors.string )) Cvar_DirectSet( &czm_touch_anchors, value );
 }
 
