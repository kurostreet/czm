+// Migrate saved profiles by command, preserving their positions, icons and hidden state.
+static void Touch_CzmEnsureFortifications( qboolean force )
+{
+    if( !force && ( !touch.config_loaded || cls.state != ca_active || !(int)czm_fort_mask.value )) return;
+    static const char *commands[] = { "czm_props", "czm_lasermine" };
+    static const char *names[] = { "czm_fort_props", "czm_fort_laser" };
+    static const char *icons[] = { "props", "lasermine" };
+    static const float positions[] = { 0.65f, 0.72f };
+    byte color[4] = { 255, 255, 255, 235 };
+    for( int i = 0; i < 2; i++ )
+    {
+        qboolean exists = false;
+        for( touch_button_t *b = touch.list_user.first; b; b = b->next )
+            if( !Q_strcmp( b->command, commands[i] )) { exists = true; break; }
+        if( exists ) continue;
+        // Touch_AddButton replaces by name. A custom action may already own our preferred name.
+        char name[32], texture[80];
+        for( int suffix = 0; ; suffix++ )
+        {
+            if( suffix ) Q_snprintf( name, sizeof( name ), "%s_%d", names[i], suffix );
+            else Q_snprintf( name, sizeof( name ), "%s", names[i] );
+            qboolean taken = false;
+            for( touch_button_t *b = touch.list_user.first; b; b = b->next )
+                if( !Q_strcmp( b->name, name )) { taken = true; break; }
+            if( !taken ) break;
+        }
+        Q_snprintf( texture, sizeof( texture ), "gfx/czm/touch/%s.png", icons[i] );
+        touch_button_t *b = Touch_AddButton( &touch.list_user, name, texture, commands[i],
+            positions[i], 0.58f, positions[i] + 0.06f, 0.58f + 0.06f / Touch_AspectRatio(), color, true );
+        b->aspect = 1.0f;
+        touch.configchanged = true;
+    }
+}
+
+static void Touch_CzmEnsureFortifications_f( void ) { Touch_CzmEnsureFortifications( true ); }
+
