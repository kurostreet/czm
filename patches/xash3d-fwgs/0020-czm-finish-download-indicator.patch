 	Cvar_SetValue( "scr_loading", (int)czm.percent );
 }
 
+// HTTP completion may leave scr_download at the last displayed value. Retire only a
+// completed in-match transfer with no resources left; a queued or new transfer cancels it.
+static void CZM_DownloadProgress( void )
+{
+	static double finished = -1.0;
+
+	if( !czm.active && cls.state == ca_active && host.downloadcount == 0 && scr_download.value >= 99.5f )
+	{
+		double now = Platform_DoubleTime();
+		if( finished < 0.0 || now < finished )
+			finished = now;
+		else if( now - finished >= 2.0 )
+		{
+			Cvar_SetValue( "scr_download", -1.0f );
+			finished = -1.0;
+		}
+	}
+	else finished = -1.0;
+
+	CZM_SetValue( &czm_download_files, scr_download.value >= 0.0f ? host.downloadcount : 0 );
+}
