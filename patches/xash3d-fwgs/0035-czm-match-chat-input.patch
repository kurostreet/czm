+// A native chat submission is data, never text fed back into Cbuf. Limit the
+// wire payload to the CS chat limit, reject controls and malformed/overlong UTF-8.
+static qboolean Con_CzmValidChat( const char *text )
+{
+	const byte *p = (const byte *)text;
+	size_t length = Q_strlen( text );
+	qboolean visible = false;
+	if( !length || length > 190 ) return false;
+	for( size_t i = 0; i < length; )
+	{
+		const byte c = p[i];
+		int count;
+		if( c < 32 || c == 127 ) return false;
+		if( c != ' ' ) visible = true;
+		if( c < 128 ) { ++i; continue; }
+		if( c >= 0xC2 && c <= 0xDF ) count = 2;
+		else if( c >= 0xE0 && c <= 0xEF ) count = 3;
+		else if( c >= 0xF0 && c <= 0xF4 ) count = 4;
+		else return false;
+		if( i + count > length ) return false;
+		for( int k = 1; k < count; ++k )
+			if(( p[i + k] & 0xC0 ) != 0x80 ) return false;
+		if(( c == 0xE0 && p[i + 1] < 0xA0 ) || ( c == 0xED && p[i + 1] >= 0xA0 )
+			|| ( c == 0xF0 && p[i + 1] < 0x90 ) || ( c == 0xF4 && p[i + 1] > 0x8F )) return false;
+		i += count;
+	}
+	return visible;
+}
+
+static int Con_CzmHexDigit( char c )
+{
+	if( c >= '0' && c <= '9' ) return c - '0';
+	if( c >= 'A' && c <= 'F' ) return c - 'A' + 10;
+	if( c >= 'a' && c <= 'f' ) return c - 'a' + 10;
+	return -1;
+}
+
+static qboolean Con_CzmDecodeChatHex( const char *hex, char text[191] )
+{
+	const size_t length = Q_strlen( hex );
+	if( !length || length > 380 || ( length & 1 )) return false;
+	for( size_t i = 0; i < length; i += 2 )
+	{
+		const int a = Con_CzmHexDigit( hex[i] ), b = Con_CzmHexDigit( hex[i + 1] );
+		if( a < 0 || b < 0 || ( a == 0 && b == 0 )) return false;
+		text[i / 2] = (char)(( a << 4 ) | b );
+	}
+	text[length / 2] = 0;
+	return Con_CzmValidChat( text );
+}
+
+static void Con_CzmReleaseChatInput( void )
+{
+	Touch_ResetLoadingInput();
+	Key_ClearStates();
+	Key_EnableTextInput( false, true );
+}
+
+void Con_CzmMatchChatReset( void )
+{
+	char value[32];
+	if( ++czm_chat_epoch > 1000000000u ) czm_chat_epoch = 1;
+	Q_snprintf( value, sizeof( value ), "%u", czm_chat_epoch );
+	Cvar_DirectFullSet( &czm_match_chat_epoch, value, 0 );
+	Cvar_DirectFullSet( &czm_match_chat_request, "0 0", 0 );
+	Cvar_DirectFullSet( &czm_match_chat_ime_pending, "0", 0 );
+	Cvar_DirectSet( &czm_match_chat_active, "0" );
+	Con_CzmReleaseChatInput();
+	if( cls.key_dest == key_message )
+	{
+		Con_ClearField( &con.chat );
+		Key_SetKeyDest( key_game );
+	}
+}
+
+static qboolean Con_CzmWriteChat( qboolean team, const char *text )
+{
+	char command[208];
+	if( cls.state != ca_active || cls.demoplayback || host.status != HOST_FRAME || !Con_CzmValidChat( text )) return false;
+	// SV_ExecuteClientCommand tokenizes this ONE network string. It does not
+	// split semicolons, and quotes remain inside the raw say argument string.
+	Q_snprintf( command, sizeof( command ), "%s \"%s\"", team ? "say_team" : "say", text );
+	MSG_BeginClientCmd( &cls.netchan.message, clc_stringcmd );
+	MSG_WriteString( &cls.netchan.message, command );
+	return true;
+}
+
+static qboolean Con_CzmRequestChat( qboolean team )
+{
+	char request[48];
+	if( !czm_match_chat.value || !gameui.hInstance ) return false;
+	if( cls.state != ca_active || cls.demoplayback || host.status != HOST_FRAME ) return true;
+	Cvar_DirectFullSet( &czm_match_chat_ime_pending, "0", 0 );
+	Con_CzmReleaseChatInput();
+	Key_SetKeyDest( key_menu ); // consume subsequent fingers before the UI frame
+	Cvar_DirectSet( &czm_match_chat_active, "1" );
+	if( ++czm_chat_request_serial > 1000000000u ) czm_chat_request_serial = 1;
+	Q_snprintf( request, sizeof( request ), "%u %d", czm_chat_request_serial, team ? 1 : 0 );
+	Cvar_DirectFullSet( &czm_match_chat_request, request, 0 );
+	return true;
+}
+
+static void Con_CzmMatchChatSend_f( void )
+{
+	char text[191];
+	if( Cmd_Argc() != 4 || !czm_match_chat_active.value || cls.key_dest != key_menu ) return;
+	if( Q_strcmp( Cmd_Argv( 1 ), "0" ) && Q_strcmp( Cmd_Argv( 1 ), "1" )) return;
+	if( Q_strcmp( Cmd_Argv( 2 ), czm_match_chat_epoch.string )) return;
+	if( Con_CzmDecodeChatHex( Cmd_Argv( 3 ), text ))
+		Con_CzmWriteChat( !Q_strcmp( Cmd_Argv( 1 ), "1" ), text );
+}
+
+static void Con_CzmMatchChatClose_f( void )
+{
+	if( Cmd_Argc() == 2 && (unsigned int)Q_atoi( Cmd_Argv( 1 )) != czm_chat_request_serial ) return;
+	Cvar_DirectSet( &czm_match_chat_active, "0" );
+	Con_CzmReleaseChatInput();
+	// The menu stack owns returning to key_game; do not dismiss another menu.
+}
+
+static void Con_CzmMatchChatIme_f( void )
+{
+	if( cls.state != ca_active || cls.demoplayback || host.status != HOST_FRAME ) return;
+	const qboolean defer = czm_match_chat_active.value != 0;
+	// Argv[1] is the channel here, not the close command's request serial.
+	Cvar_DirectSet( &czm_match_chat_active, "0" );
+	Con_CzmReleaseChatInput();
+	// The native stack must close before it can return keyboard ownership.
+	Cvar_DirectFullSet( &czm_match_chat_ime_pending, defer ? ( !Q_strcmp( Cmd_Argv( 1 ), "1" ) ? "2" : "1" ) : "0", 0 );
+	if( defer ) return;
+	g_messagemode_privileged = Cmd_CurrentCommandIsPrivileged();
+	Q_strncpy( con.chat_cmd, !Q_strcmp( Cmd_Argv( 1 ), "1" ) ? "say_team" : "say", sizeof( con.chat_cmd ));
+	Con_ClearField( &con.chat );
+	Key_SetKeyDest( key_message );
+}
+
+static void Con_CzmMatchChatFrame( void )
+{
+	if( czm_match_chat_active.value && ( cls.state != ca_active || cls.demoplayback
+		|| host.status != HOST_FRAME || cls.key_dest != key_menu )) Con_CzmMatchChatReset();
+}
