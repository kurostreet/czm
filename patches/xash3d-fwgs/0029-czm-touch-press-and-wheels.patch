+/*
+============
+Counter Zombie Mobile: the press animation (czm_touch_press)
+
+A pressed round button sinks by 8% and its disc lights up, a thin ring runs out of it and
+fades (red for fire), and when it is let go it springs back a little past its size.
+Instead of the stock highlight colour; the editors and text buttons stay as they were.
+============
+*/
+static int Touch_CzmTexture( int *texture, const char *path );
+static int czm_fx_dot, czm_fx_ring; // 0 not loaded yet, -1 missing
+
+#define CZM_PRESS_IN 0.07f  // seconds to sink
+#define CZM_PRESS_OUT 0.22f // seconds to come back
+#define CZM_RIPPLE 0.38f    // seconds of the ring
+
+static float Touch_CzmEase( float t )
+{
+	t = bound( 0.0f, t, 1.0f );
+	return t * t * ( 3.0f - 2.0f * t );
+}
+
+static qboolean Touch_CzmAnimated( const touch_button_t *b )
+{
+	return czm_touch_press.value && touch.state == state_none && b->texture[0] && b->texture[0] != '#'
+		&& !FBitSet( b->flags, TOUCH_FL_CLIENT )
+		&& ( b->type == touch_command || b->type == touch_czmwheel || b->type == touch_wheel );
+}
+
+static float Touch_CzmDepth( const touch_button_t *b )
+{
+	if( b->finger != -1 || b->latched )
+		return Touch_CzmEase(( host.realtime - b->czm_down ) / CZM_PRESS_IN );
+	if( b->czm_up > 0.0 && host.realtime - b->czm_up < CZM_PRESS_OUT )
+		return b->czm_depth * ( 1.0f - Touch_CzmEase(( host.realtime - b->czm_up ) / CZM_PRESS_OUT ));
+	return 0.0f;
+}
+
+// the finger left the button: remember how deep it was for the way back
+static void Touch_CzmLetGo( touch_button_t *b )
+{
+	b->czm_depth = Touch_CzmDepth( b );
+	b->czm_up = host.realtime;
+	b->finger = -1;
+}
+
+static void Touch_CzmDrawPressed( touch_button_t *b, const byte *color )
+{
+	const float cx = ( b->x1 + b->x2 ) * 0.5f, cy = ( b->y1 + b->y2 ) * 0.5f;
+	const float hw = ( b->x2 - b->x1 ) * 0.5f, hh = ( b->y2 - b->y1 ) * 0.5f;
+	const qboolean down = b->finger != -1 || b->latched;
+	const float depth = Touch_CzmDepth( b );
+	const double age = host.realtime - b->czm_down;
+	float scale = 1.0f - 0.08f * depth;
+	rgba_t c;
+
+	// a small spring past the rest size after letting go
+	if( !down && b->czm_up > 0.0 && host.realtime - b->czm_up < 0.3 )
+	{
+		const float t = ( host.realtime - b->czm_up ) / 0.3f;
+		scale += 0.03f * b->czm_depth * sinf( t * M_PI_F ) * ( 1.0f - t );
+	}
+
+	Vector4Copy( color, c );
+	Touch_DrawTexture( cx - hw * scale, cy - hh * scale, cx + hw * scale, cy + hh * scale, b->gl_texturenum, c );
+
+	// pressed: the disc lights up (additive, so the colour carries the strength)
+	if( depth > 0.0f && Touch_CzmTexture( &czm_fx_dot, "gfx/czm/ui/dot.png" ))
+	{
+		const byte light = 50 * depth * color[3] / 255;
+
+		c[0] = c[1] = c[2] = light;
+		c[3] = 255;
+		ref.dllFuncs.GL_SetRenderMode( kRenderTransAdd );
+		Touch_DrawTexture( cx - hw * scale * 0.92f, cy - hh * scale * 0.92f, cx + hw * scale * 0.92f, cy + hh * scale * 0.92f, czm_fx_dot, c );
+		ref.dllFuncs.GL_SetRenderMode( kRenderTransTexture );
+	}
+
+	// the ring that runs out of the button when it goes down
+	if( b->czm_down > 0.0 && age >= 0.0 && age < CZM_RIPPLE && Touch_CzmTexture( &czm_fx_ring, "gfx/czm/ui/touch_ripple.png" ))
+	{
+		const float t = age / CZM_RIPPLE;
+		const float grow = 1.0f + 0.42f * ( 1.0f - ( 1.0f - t ) * ( 1.0f - t ));
+		const qboolean fire = !Q_strcmp( b->command, "+attack" );
+
+		c[0] = 255;
+		c[1] = fire ? 72 : 255;
+		c[2] = fire ? 84 : 255;
+		c[3] = 210 * ( 1.0f - t ) * ( 1.0f - t ) * color[3] / 255;
+		Touch_DrawTexture( cx - hw * grow, cy - hh * grow, cx + hw * grow, cy + hh * grow, czm_fx_ring, c );
+	}
+}
