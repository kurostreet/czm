+/*
+============
+Counter Zombie Mobile: wheels on touch buttons ("_czmwheel weapons", "_czmwheel radio";
+the stock radio button "showvguimenu 38" is the radio wheel)
+
+The engine follows the finger, the menu draws the wheel and runs what was picked
+(czm/menu/CzmWheels.cpp). While a wheel is up, czm_wheel is
+"<kind> <mode> <cx> <cy> <radius> <dx> <dy> <pointing> <shown>" in screen pixels, "" otherwise;
+a choice runs "czm_wheel_pick <kind> <mode> <dx> <dy> <radius>".
+Held (mode 1): the finger that pressed the button slides, the direction from where it went
+down chooses and letting go picks; other fingers keep walking and looking. A quick tap: the
+weapon wheel switches to the last weapon (a pick of 0 0), other wheels stay open; the weapon
+wheel held up and let go without a slide picks nothing.
+Open (mode 2): the next finger picks what it is let go on (dx dy from the centre); a tap on
+the hub or outside closes it, so does a quiet while.
+============
+*/
+#define CZM_WHEEL_RADIUS 0.30f // of the screen height
+#define CZM_WHEEL_SLIDE 0.06f  // of the screen height: a shorter move is a tap
+#define CZM_WHEEL_HUB 0.30f    // of the radius
+#define CZM_WHEEL_EDGE 1.12f   // of the radius
+#define CZM_WHEEL_SHOW 0.2     // seconds: a quick tap never shows the wheel
+#define CZM_WHEEL_IDLE 6.0     // seconds an open wheel waits for a tap
+
+enum { CZM_WHEEL_NONE, CZM_WHEEL_HELD, CZM_WHEEL_OPEN };
+
+static struct
+{
+	int mode;
+	char kind[16];
+	int finger;             // the finger that slides or picks, -1 none
+	touch_button_t *button; // the button held for the wheel
+	float cx, cy, r;        // the wheel on the screen, pixels
+	float sx, sy, fx, fy;   // where the held finger went down and where the finger is, pixels
+	qboolean slid;
+	double down, active;
+} czm_wheel = { .mode = CZM_WHEEL_NONE, .finger = -1 };
+
+static void Touch_CzmWheelPublish( void )
+{
+	char value[128] = "";
+
+	if( czm_wheel.mode != CZM_WHEEL_NONE )
+	{
+		const qboolean held = czm_wheel.mode == CZM_WHEEL_HELD;
+		const float dx = czm_wheel.fx - ( held ? czm_wheel.sx : czm_wheel.cx );
+		const float dy = czm_wheel.fy - ( held ? czm_wheel.sy : czm_wheel.cy );
+		const int pointing = held ? czm_wheel.slid : czm_wheel.finger != -1;
+		const int shown = !held || czm_wheel.slid || host.realtime - czm_wheel.down >= CZM_WHEEL_SHOW;
+
+		Q_snprintf( value, sizeof( value ), "%s %d %d %d %d %d %d %d %d", czm_wheel.kind, czm_wheel.mode,
+			(int)czm_wheel.cx, (int)czm_wheel.cy, (int)czm_wheel.r, (int)dx, (int)dy, pointing, shown );
+	}
+
+	if( Q_strcmp( value, czm_wheel_state.string ))
+		Cvar_DirectSet( &czm_wheel_state, value );
+}
+
+static void Touch_CzmWheelClose( void )
+{
+	if( czm_wheel.mode == CZM_WHEEL_NONE )
+		return;
+	if( czm_wheel.button && czm_wheel.button->finger == czm_wheel.finger && czm_wheel.finger != -1 )
+		Touch_CzmLetGo( czm_wheel.button );
+	czm_wheel.mode = CZM_WHEEL_NONE;
+	czm_wheel.finger = -1;
+	czm_wheel.button = NULL;
+	Touch_CzmWheelPublish();
+}
+
+// a button goes away: the wheel must not touch it any more
+static void Touch_CzmWheelForget( const touch_button_t *button )
+{
+	if( czm_wheel.button == button )
+		czm_wheel.button = NULL;
+}
+
+static void Touch_CzmWheelPick( float dx, float dy )
+{
+	Cbuf_AddText( va( "czm_wheel_pick %s %d %d %d %d\n", czm_wheel.kind, czm_wheel.mode, (int)dx, (int)dy, (int)czm_wheel.r ));
+}
+
+static void Touch_CzmWheelOpen( touch_button_t *button, int fingerID, float x, float y )
+{
+	const float r = refState.height * CZM_WHEEL_RADIUS, margin = r * CZM_WHEEL_EDGE;
+	const char *kind = "radio";
+	size_t n;
+
+	if( !Q_strncmp( button->command, "_czmwheel ", 10 ))
+		kind = button->command + 10;
+	for( n = 0; kind[n] && kind[n] != ' ' && n < sizeof( czm_wheel.kind ) - 1; n++ )
+		czm_wheel.kind[n] = kind[n];
+	czm_wheel.kind[n] = 0;
+
+	// round about the button, moved in from the edges to fit the screen
+	czm_wheel.r = r;
+	czm_wheel.cx = bound( margin, TO_SCRN_X(( button->x1 + button->x2 ) * 0.5f ), refState.width - margin );
+	czm_wheel.cy = bound( margin, TO_SCRN_Y(( button->y1 + button->y2 ) * 0.5f ), refState.height - margin );
+	czm_wheel.sx = czm_wheel.fx = TO_SCRN_X( x );
+	czm_wheel.sy = czm_wheel.fy = TO_SCRN_Y( y );
+	czm_wheel.mode = CZM_WHEEL_HELD;
+	czm_wheel.finger = fingerID;
+	czm_wheel.button = button;
+	czm_wheel.slid = false;
+	czm_wheel.down = czm_wheel.active = host.realtime;
+	Touch_CzmWheelPublish();
+}
+
+static qboolean Touch_CzmWheelEvent( touchEventType type, int fingerID, float x, float y )
+{
+	const float px = TO_SCRN_X( x ), py = TO_SCRN_Y( y );
+	float dx, dy, d;
+
+	if( czm_wheel.mode == CZM_WHEEL_NONE )
+		return false;
+
+	if( czm_wheel.mode == CZM_WHEEL_HELD )
+	{
+		if( fingerID != czm_wheel.finger )
+			return false; // other fingers keep walking and looking
+
+		czm_wheel.fx = px;
+		czm_wheel.fy = py;
+		czm_wheel.active = host.realtime;
+		dx = px - czm_wheel.sx;
+		dy = py - czm_wheel.sy;
+		if( dx * dx + dy * dy > refState.height * CZM_WHEEL_SLIDE * refState.height * CZM_WHEEL_SLIDE )
+			czm_wheel.slid = true;
+
+		if( type != event_up )
+		{
+			Touch_CzmWheelPublish();
+			return true;
+		}
+
+		if( czm_wheel.button )
+			Touch_CzmLetGo( czm_wheel.button );
+		czm_wheel.button = NULL;
+
+		if( czm_wheel.slid )
+		{
+			Touch_CzmWheelPick( dx, dy );
+			Touch_CzmWheelClose();
+		}
+		else if( !Q_strcmp( czm_wheel.kind, "weapons" ))
+		{
+			// a tap: the last weapon; held up and let go without a slide: changed one's mind
+			if( host.realtime - czm_wheel.down < CZM_WHEEL_SHOW )
+				Touch_CzmWheelPick( 0, 0 );
+			Touch_CzmWheelClose();
+		}
+		else
+		{
+			// a tap: the wheel stays up for a tap on a choice
+			czm_wheel.mode = CZM_WHEEL_OPEN;
+			czm_wheel.finger = -1;
+			czm_wheel.active = host.realtime;
+			Touch_CzmWheelPublish();
+		}
+		return true;
+	}
+
+	// open: the next finger picks what it is let go on
+	dx = px - czm_wheel.cx;
+	dy = py - czm_wheel.cy;
+	d = sqrtf( dx * dx + dy * dy );
+
+	if( type == event_down )
+	{
+		if( czm_wheel.finger != -1 )
+			return true; // one finger picks at a time
+		if( d > czm_wheel.r * CZM_WHEEL_EDGE || d < czm_wheel.r * CZM_WHEEL_HUB )
+		{
+			Touch_CzmWheelClose(); // outside or the hub: closed, nothing picked
+			return true;
+		}
+		czm_wheel.finger = fingerID;
+	}
+	else if( fingerID != czm_wheel.finger )
+		return false;
+
+	czm_wheel.fx = px;
+	czm_wheel.fy = py;
+	czm_wheel.active = host.realtime;
+
+	if( type == event_up )
+	{
+		if( d <= czm_wheel.r * CZM_WHEEL_EDGE && d >= czm_wheel.r * CZM_WHEEL_HUB )
+			Touch_CzmWheelPick( dx, dy );
+		Touch_CzmWheelClose();
+		return true;
+	}
+
+	Touch_CzmWheelPublish();
+	return true;
+}
+
+// every frame: the wheel shows itself after a moment of holding, closes outside the match
+static void Touch_CzmWheelFrame( void )
+{
+	if( czm_wheel.mode == CZM_WHEEL_NONE )
+		return;
+
+	if( cls.key_dest != key_game || touch.state != state_none || cls.state != ca_active
+		|| ( czm_wheel.mode == CZM_WHEEL_OPEN && czm_wheel.finger == -1 && host.realtime - czm_wheel.active > CZM_WHEEL_IDLE ))
+	{
+		Touch_CzmWheelClose();
+		return;
+	}
+
+	Touch_CzmWheelPublish();
+}
