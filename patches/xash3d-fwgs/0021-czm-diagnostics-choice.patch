+// Apply the player's archived choice, never a server-selected debug level.
+void CZM_Diagnostics_Apply( void )
+{
+	convar_t *choice = Cvar_FindVar( "czm_diagnostics" );
+	if( choice && CZM_Loading_Enabled() )
+		Cvar_DirectSetValue( &host_developer, bound( 0, (int)choice->value, 2 ));
+}
+
 // Build credentials only into the packet for its actual destination. Never mutate
 // cls.userinfo: config writes, local player info and later connections stay clean.
 static const char *CZM_ConnectUserinfo( netadr_t adr, char *out, size_t size )
 {
+ CZM_Diagnostics_Apply();
+ // Remember the actual packet destination, including redirects and console joins.
+ Cvar_Set( "czm_retry_address", NET_AdrToString( adr ));
+ Cvar_Set( "czm_retry_protocol", cls.net_protocol == PROTO_GOLDSRC ? "gs" : "49" );
  Q_strncpy( out, cls.userinfo, size );
 #ifdef __ANDROID__
  JNIEnv *env = Android_GetNativeObject( "JNIEnv" );
@@ -1850,6 +1862,7 @@
 	cls.state = ca_connected;
 	cls.signon = 0;
 
+	CZM_Diagnostics_Apply();
 	CL_ServerCommand( true, "new" );
 
 	cl.validsequence = 0;		// haven't gotten a valid frame update yet
