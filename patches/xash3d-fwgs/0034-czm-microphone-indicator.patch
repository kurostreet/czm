diff --git a/engine/client/sound/voice.c b/engine/client/sound/voice.c
--- a/engine/client/sound/voice.c
+++ b/engine/client/sound/voice.c
@@ -34,6 +34,35 @@
 
 static void Voice_StartChannel( uint samples, byte *data, int entnum );
 
+// Engine-owned local capture state; PCM level is not a delivery acknowledgement.
+static CVAR_DEFINE_AUTO( czm_voice_held, "0", FCVAR_READ_ONLY | FCVAR_PRIVILEGED, "push-to-talk is held" );
+static CVAR_DEFINE_AUTO( czm_voice_recording, "0", FCVAR_READ_ONLY | FCVAR_PRIVILEGED, "live microphone capture is active" );
+static CVAR_DEFINE_AUTO( czm_voice_level, "0", FCVAR_READ_ONLY | FCVAR_PRIVILEGED, "local captured PCM RMS level" );
+static double czm_voice_sample_time;
+
+static void Voice_CzmSetValue( convar_t *var, float value )
+{
+	char text[32];
+	if( var->value == value ) return;
+	Q_snprintf( text, sizeof( text ), "%.4f", value );
+	if( Q_strcmp( var->string, text )) Cvar_DirectFullSet( var, text, 0 );
+}
+
+static void Voice_CzmMeter( const int16_t *samples, uint count )
+{
+	double square = 0.0;
+	float level = 0.0f;
+	// A WAV test input must never be presented as microphone capture.
+	if( czm_voice_held.value && voice.is_recording && !voice.input_file )
+	{
+		for( uint i = 0; i < count; i++ ) square += (double)samples[i] * samples[i];
+		const float rms = count ? sqrt( square / count ) : 0.0f;
+		level = rms < 80.0f ? 0.0f : bound( 0.0f, rms / 6500.0f, 1.0f );
+	}
+	Voice_CzmSetValue( &czm_voice_level, level );
+	czm_voice_sample_time = host.realtime;
+}
+
