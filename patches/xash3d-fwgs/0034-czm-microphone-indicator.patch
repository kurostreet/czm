+static void Voice_CzmMeterFrame( void )
+{
+	if( !czm_voice_held.value ) return;
+	if( cls.state != ca_active || cls.key_dest != key_game || host.status != HOST_FRAME )
+	{
+		Voice_RecordStop();
+		return;
+	}
+	Voice_CzmSetValue( &czm_voice_recording, Voice_IsRecording() && !voice.input_file ? 1 : 0 );
