# Counter Zombie Mobile (imported by /etc/caddy/Caddyfile from /etc/caddy/sites/*.caddy).
# No access log: requests carry the players' keys in a header.
# The previous hostname remains available to installed clients.
counter-zombie.ru, kontrafps.ru {
	encode gzip
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}

	# Stable public link resolves the latest published full APK on each visit.
	@latest_apk path /download /download/CounterZombieMobile.apk
	handle @latest_apk {
		reverse_proxy 127.0.0.1:8200
	}

	# new builds from GitHub Actions (players' APK and the Google Play bundle), the service checks the workflow token
	@builds path /api/v1/builds /api/v1/play-builds
	handle @builds {
		request_body {
			max_size 700MB
		}
		reverse_proxy 127.0.0.1:8200
	}

	handle /api/* {
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8200
	}

	# players' own avatars, 192 px PNG
	handle_path /avatars/* {
		root * /var/lib/czm/avatars
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# Shared map previews
	handle_path /mappics/* {
		root * /var/lib/czm/mappics
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# APK downloads continue after a break (Range)
	handle_path /dl/* {
		root * /var/lib/czm/apk
		file_server
	}

	handle_path /server-list/* {
		root * /var/lib/czm/server-list
		file_server
	}

	# the public site from the current release: pictures, fonts and the script (links carry ?v=<commit>)
	handle /assets/* {
		root * /opt/czm/current/site
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# pages: / and /privacy; the hash allows the one inline line that applies the saved theme
	handle {
		root * /opt/czm/current/site
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-PT1f7ai2CTSaZ/SGiYakcFr5/ubFfkcq3Ba8RwmnjfI='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
			X-Frame-Options DENY
			Cache-Control "no-cache"
		}
		try_files {path} {path}.html
		file_server
	}
}

www.kontrafps.ru {
	redir https://kontrafps.ru{uri} permanent
}

www.counter-zombie.ru {
	redir https://counter-zombie.ru{uri} permanent
}

# the engine fetches the server list over plain HTTP
http://counter-zombie.ru, http://kontrafps.ru {
	handle_path /server-list/* {
		root * /var/lib/czm/server-list
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
